NODE_ENV=development
PORT=4001
# Supabase transaction pooler, port 6543 (runtime queries)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase session pooler, port 5432 (Prisma migrations)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional locally; unused at runtime (auth is Supabase JWT)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
FRONTEND_URL=http://localhost:5174
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
# Email of the first admin account (matched case-insensitively on sign-in)
ADMIN_EMAIL=you@example.com
